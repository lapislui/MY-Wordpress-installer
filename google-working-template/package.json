    "url": "git+https://github.com/usanusa666/browser.git"
  },
  "keywords": [
    "browser",
    "web-browser",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/usanusa666/browser/issues"
  },
  "homepage": "https://github.com/usanusa666/browser#readme",
  "devDependencies": {
    "electron": "^31.0.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.browser",
    "productName": "Browser",
    "files": [
      "index.js",
      "index.html",
      "preload.js",
      "package.json"
