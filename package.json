{
  "name": "my-wordpress-installer",
  "version": "1.0.0",
  "description": "Electron browser and WordPress installer for local XAMPP workflows.",
  "productName": "WP Desktop",
  "author": "Keval",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --win nsis dir"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "mysql2": "^3.11.3"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.keval.wpdesktop",
    "productName": "WP Desktop",
    "artifactName": "${productName}-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "dialog-preload.js",
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
