{
  "name": "my-wordpress-installer",
  "version": "0.0.6",
  "description": "Electron browser and WordPress installer for local XAMPP and Laragon workflows.",
  "productName": "WP Desktop",
  "author": "Keval",
  "main": "main.js",
  "scripts": {
    "prestart": "npm run build:mcp",
    "start": "node scripts/start-electron.js",
    "build:mcp": "tsc -p tsconfig.mcp.json",
    "postinstall": "electron-builder install-app-deps",
    "pack:win": "npm run build:mcp && electron-builder --win nsis dir --publish never",
    "setup:win": "npm run pack:win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^12.10.0",
    "monaco-editor": "^0.49.0",
    "mysql2": "^3.11.3",
    "peerjs": "^1.5.4",
    "pg": "^8.23.0",
    "playwright": "^1.60.0",
    "ssh2": "^1.17.0",
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "electron": "31.7.7",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "com.keval.wpdesktop",
    "productName": "WP Desktop",
    "artifactName": "${productName}-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "files": [
      "main.js",
      "preload.js",
      "dialog-preload.js",
      "lib/**/*",
      "scripts/**/*",
      "src/**/*",
      "!src/**/*.backup",
      "mcp/**/*",
      "mcp-dist/**/*",
      "tsconfig.mcp.json",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "dir"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "warningsAsErrors": false
    }
  }
}
